rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Laws collection — authenticated users can read; authenticated users can create
    match /laws/{lawId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Only admin can update (approve/reject)
      allow update: if request.auth != null && request.auth.token.email == 'nevilsanish@gmail.com';

      // RAG chunks + embeddings for this law — any signed-in user can read
      // (needed for retrieval in chat); only the admin writes them, since
      // they're generated automatically when a law is approved.
      match /chunks/{chunkId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.email == 'nevilsanish@gmail.com';
      }
    }
  }
}
